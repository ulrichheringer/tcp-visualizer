<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:TcpVisualizer.ViewModels" mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650" x:Class="TcpVisualizer.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="28" Spacing="18" MaxWidth="840" HorizontalAlignment="Center">
    <TextBlock Text="TCP Visualizer" FontSize="30" FontWeight="Bold"/><TextBlock Text="Avance pelo handshake, estados e encerramento da conexão." Opacity="0.75"/>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><Border Grid.Column="0" Padding="16" CornerRadius="8" Background="#DBEAFE"><StackPanel><TextBlock Text="Cliente"/><TextBlock Text="{Binding ClientState}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><TextBlock Grid.Column="1" Text="⇄" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28"/><Border Grid.Column="2" Padding="16" CornerRadius="8" Background="#DCFCE7"><StackPanel><TextBlock Text="Servidor"/><TextBlock Text="{Binding ServerState}" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid>
    <CheckBox Content="Perder o próximo SYN/ACK e mostrar retransmissão" IsChecked="{Binding LoseSynAck}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Próximo passo" Command="{Binding NextStepCommand}"/><Button Content="Reiniciar" Command="{Binding ResetCommand}"/></StackPanel>
    <TextBlock Text="Pacotes e eventos" FontSize="18" FontWeight="SemiBold"/><Border Padding="14" CornerRadius="8" Background="#F1F5F9"><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
  </StackPanel></ScrollViewer>
</UserControl>
